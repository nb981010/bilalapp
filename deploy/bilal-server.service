[Unit]
Description=Bilal Azan Server (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nbc/bilalapp
Environment=PYTHONUNBUFFERED=1
Environment=TESTING_TOKEN=ryhaYpDKnmffQ2NXXdPMOeerEiV7CybV
# Single worker to avoid multiple schedulers
ExecStart=/home/nbc/bilalapp/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:5000 --timeout 120 server:app
Restart=always
RestartSec=10
# Prevent crash loops: max 5 restarts in 10 minutes
StartLimitBurst=5
StartLimitIntervalSec=600
StandardOutput=journal
StandardError=journal
# Set resource limits for Raspberry Pi
MemoryMax=512M
CPUQuota=80%

[Install]
WantedBy=default.target
