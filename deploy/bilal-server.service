[Unit]
Description=Bilal Azan Server (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nbc/bilalapp
Environment=PYTHONUNBUFFERED=1
Environment=TESTING_TOKEN=ryhaYpDKnmffQ2NXXdPMOeerEiV7CybV
# Single worker to avoid multiple schedulers; preload to init scheduler once.
ExecStart=/home/nbc/bilalapp/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:5000 --preload server:app
Restart=always
RestartSec=5
StandardOutput=append:/home/nbc/bilalapp/logs/server_stdout.log
StandardError=append:/home/nbc/bilalapp/logs/sys.log

[Install]
WantedBy=default.target
