[Unit]
Description=Bilal Azan Server (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nbc/bilalapp
Environment=PYTHONUNBUFFERED=1
Environment=TESTING_TOKEN=ryhaYpDKnmffQ2NXXdPMOeerEiV7CybV
# Single worker to avoid multiple schedulers
ExecStart=/home/nbc/bilalapp/venv/bin/gunicorn --config /home/nbc/bilalapp/gunicorn.conf.py server:app
Restart=always
RestartSec=10
# Allow up to 10 restarts in 30 minutes before systemd gives up
StartLimitBurst=10
StartLimitIntervalSec=1800
StandardOutput=journal
StandardError=journal
# Set resource limits for Raspberry Pi
MemoryMax=512M
CPUQuota=80%

[Install]
WantedBy=default.target
