[Unit]
Description=Bilal Frontend Server (Node.js)
After=network.target bilal-server.service
Requires=bilal-server.service

[Service]
Type=simple
WorkingDirectory=/home/nbc/bilalapp
Environment="PORT=3000"
Environment="NODE_ENV=production"

# Ensure frontend is built before starting
ExecStartPre=/bin/bash /home/nbc/bilalapp/deploy/ensure-frontend-built.sh

# Start Node.js static server
ExecStart=/usr/bin/node /home/nbc/bilalapp/server-static.cjs

# Restart configuration
Restart=on-failure
RestartSec=10s
StartLimitBurst=5
StartLimitIntervalSec=300s

# Resource limits
MemoryMax=512M
CPUQuota=100%%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bilal-frontend

[Install]
WantedBy=default.target
